#!/usr/bin/env bash
# fleet-ops — hatch-cell saturation ops skills autonomous rig (bin/check).
# Self-test gate (PASS / FAIL / WARN). Non-destructive only:
#   1. Every .py compiles; every shell script passes `bash -n`.
#   2. Dry-run/help smoke on the key operational scripts (orphan-reaper,
#      io-rate-reaper, saturation-watchdog). Destructive reapers default to
#      dry-run and are invoked with --help only.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== fleet-ops check: start =="
pybin="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"

echo "-- python compile --"
fails=0
for p in *.py; do
  "$pybin" -m py_compile "$p" 2>&1 && echo "OK: $p" || { echo "FAIL: $p"; fails=$((fails+1)); }
done
[ "$fails" -eq 0 ] || { echo "FAIL: $fails python file(s)"; exit 1; }

echo "-- shell syntax (bash -n) --"
sfails=0
for s in *.sh io-lease io-rate-reaper iowait-gate oracle-judge orphan-reaper \
         safe-rg saturation-watchdog; do
  [ -f "$s" ] || continue
  bash -n "$s" 2>/dev/null && echo "OK: $s" || { echo "FAIL(shell): $s"; sfails=$((sfails+1)); }
done
[ "$sfails" -eq 0 ] || { echo "FAIL: $sfails shell file(s)"; exit 1; }

echo "-- operational script help/dry-run smoke --"
for s in orphan-reaper io-rate-reaper saturation-watchdog; do
  out="$(timeout 15 ./$s --help 2>&1 || true)"
  if [ -n "$out" ]; then echo "OK: $s responds ($(echo "$out" | head -1))"; else echo "WARN: $s produced no help output"; fi
done

echo "== fleet-ops check: PASS =="